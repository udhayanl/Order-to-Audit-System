  description        String
  referenceNumber    String?
  withdrawal         Decimal                      @default(0.0) @db.Decimal(12, 2)
  deposit            Decimal                      @default(0.0) @db.Decimal(12, 2)
  balanceAfter       Decimal?                     @db.Decimal(12, 2)
  status             ReconciliationStatus         @default(UNRECONCILED)
  matchedTxId        String?
  matchedTx          FinancialAccountTransaction? @relation(fields: [matchedTxId], references: [id])
  createdAt          DateTime                     @default(now())

  @@index([bankStatementId])
  @@index([matchedTxId])
}

model BankReconciliation {
  id                     String        @id @default(uuid())
  reconciliationNumber   String        @unique
  bankStatementId        String
  bankStatement          BankStatement @relation(fields: [bankStatementId], references: [id])
  financialAccountId     String
  reconciliationDate     DateTime      @default(now())
  statementBalance       Decimal       @db.Decimal(12, 2)
  bookBalance            Decimal       @db.Decimal(12, 2)
  unreconciledDifference Decimal       @db.Decimal(12, 2)
  status                 String        @default("COMPLETED")
  notes                  String?
  reconciledById         String
  reconciledBy           User          @relation("UserReconciliations", fields: [reconciledById], references: [id])
  createdAt              DateTime      @default(now())

  @@index([reconciliationNumber])
  @@index([financialAccountId])
}

model AccountingPeriod {
  id         String    @id @default(uuid())
  periodName String    @unique // e.g. "FY2026-27"
  startDate  DateTime
  endDate    DateTime
  status     String    @default("OPEN") // OPEN, CLOSED, LOCKED
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime  @default(now())

  @@index([periodName])
}

model FinancialAlert {
  id            String   @id @default(uuid())
  alertType     String   // OVERDUE_INVOICE, LOW_BANK_BALANCE, UNMATCHED_PAYMENT, UNBALANCED_JOURNAL, CREDIT_LIMIT_EXCEEDED
  severity      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title         String
  message       String
  referenceType String?
  referenceId   String?
  isRead        Boolean  @default(false)
  isDismissed   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([alertType])
  @@index([isRead])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String   // "CREATE", "UPDATE", "APPROVE", "REJECT", "DISPATCH", "POST", "CANCEL"
  entityType     String   // "ORDER", "INVOICE", "PRODUCTION_RUN", "PURCHASE", "PAYMENT", "STOCK"
  entityId       String
  previousValues String?  // JSON string
  newValues      String?  // JSON string
  ipAddress      String?
  timestamp      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

// ================= PHASE 7: AUDIT MANAGEMENT & COMPLIANCE =================

enum AuditType {
  INVENTORY
  PRODUCTION
  FINANCIAL
  FOOD_SAFETY
  COMPLIANCE
  GENERAL
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum FindingCategory {
  INVENTORY
  PRODUCTION
  QUALITY
  FINANCIAL
  HYGIENE
  REGULATORY
  GENERAL
}

enum FindingSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FoodSafetyCategory {
  HYGIENE
  TEMPERATURE
  OIL_POLAR_COMPOUNDS
  PEST_CONTROL
  EQUIPMENT_SANITIZATION
  EXPIRY_VERIFICATION
}

model UserActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, APPROVE, REJECT, DISPATCH, EXPORT
  entityType  String   // AUTH, ORDER, INVOICE, PRODUCTION, PAYMENT, EXPENSE, INVENTORY, MASTER, AUDIT
  entityId    String?
  description String
  details     String?  // JSON formatted string
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
}

model AuditSession {
  id              String               @id @default(uuid())
  auditNumber     String               @unique // AUD-2026-0001
  title           String
  auditType       AuditType            @default(GENERAL)
  status          AuditStatus          @default(SCHEDULED)
  scheduledDate   DateTime
  completedDate   DateTime?
  auditorId       String
  auditor         User                 @relation("AuditorSessions", fields: [auditorId], references: [id])
  scope           String?
  summary         String?
  complianceScore Decimal?             @db.Decimal(5, 2) // e.g. 98.50%
  findings        AuditFinding[]
  inventoryItems  InventoryAuditItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

  @@index([auditType])
  @@index([status])
  @@index([scheduledDate])
}

model AuditFinding {
  id               String          @id @default(uuid())
  auditSessionId   String?
  auditSession     AuditSession?   @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  findingNumber    String          @unique // FND-2026-0001
  title            String
  category         FindingCategory @default(GENERAL)
  severity         FindingSeverity @default(MINOR)
  status           FindingStatus   @default(OPEN)
  description      String
  correctiveAction String?
  assignedToId     String?
  assignedTo       User?           @relation("AssignedFindings", fields: [assignedToId], references: [id])
  targetDate       DateTime?
  resolvedDate     DateTime?
  resolutionNotes  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@index([auditSessionId])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@index([assignedToId])
}

model InventoryAuditItem {
  id                String       @id @default(uuid())
  auditSessionId    String
  auditSession      AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  itemType          String       // RAW_MATERIAL, PACKAGING, FINISHED_GOODS
  itemId            String
  itemName          String
  itemCode          String?
  systemStock       Decimal      @db.Decimal(12, 3)
  physicalStock     Decimal      @db.Decimal(12, 3)
  varianceQuantity  Decimal      @db.Decimal(12, 3)
  unitCost          Decimal      @default(0.0) @db.Decimal(12, 2)
  varianceValue     Decimal      @default(0.0) @db.Decimal(12, 2)
  discrepancyReason String?
  status            String       @default("MATCHED") // MATCHED, DISCREPANCY_FLAGGED, RECONCILED
  createdAt         DateTime     @default(now())

  @@index([auditSessionId])
  @@index([itemType, itemId])
}

model FoodSafetyCompliance {
  id               String             @id @default(uuid())
  checkNumber      String             @unique // FSSAI-2026-0001
  checkDate        DateTime
  category         FoodSafetyCategory @default(HYGIENE)
  standardRequired String
  actualObserved   String
  isCompliant      Boolean            @default(true)
  inspectorId      String
  inspector        User               @relation("InspectorFoodSafety", fields: [inspectorId], references: [id])
  remarks          String?
  correctiveAction String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt

  @@index([category])
  @@index([checkDate])
  @@index([isCompliant])
}

