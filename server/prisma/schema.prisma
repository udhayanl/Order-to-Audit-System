datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SALESMAN
  ADMIN
  PRODUCTION_SUPERVISOR
  ACCOUNTANT_AUDITOR
  OWNER
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_ALLOCATED
  ALLOCATED
  PARTIALLY_DISPATCHED
  DISPATCHED
  COMPLETED
  CANCELLED
  INVOICED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
  CREDIT_NOTE_ISSUED
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  DISPATCH
  SALES_RETURN
  STOCK_ADJUSTMENT
  PURCHASE_RETURN
  WASTAGE
  DAMAGE
}

enum StockAdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
  PHYSICAL_COUNT
  DAMAGE
  WASTAGE
  EXPIRY
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
}

enum VarianceStatus {
  NORMAL
  EXCEEDS_TOLERANCE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  NEFT
  RTGS
  IMPS
  OTHER
}

enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum AccountType {
  CASH
  CURRENT_ACCOUNT
  SAVINGS_ACCOUNT
  OTHER
}

enum AccountTxDirection {
  IN
  OUT
}

enum AccountTxType {
  RECEIPT
  PAYMENT
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  RENT
  TRANSPORTATION
  FUEL
  LABOUR
  PACKAGING
  MAINTENANCE
  REPAIRS
  MACHINERY
  OFFICE_SUPPLIES
  INTERNET_PHONE
  ADMINISTRATIVE
  MARKETING
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum AccountNature {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ReconciliationStatus {
  UNRECONCILED
  MATCHED
  AUTO_MATCHED
  MANUALLY_MATCHED
  DISCREPANCY
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customers    Customer[]    @relation("SalesmanCustomers")
  salesOrders  SalesOrder[]  @relation("SalesmanOrders")
  approvedOrders SalesOrder[] @relation("ApprovedOrders")
  purchases    Purchase[]    @relation("UserPurchases")
  productionRuns ProductionRun[] @relation("UserProductionRuns")
  invoices     Invoice[]     @relation("UserInvoices")
  payments     Payment[]     @relation("UserPayments")
  creditNotes  CreditNote[]  @relation("UserCreditNotes")
  dispatches   Dispatch[]    @relation("UserDispatches")
  stockLedgers StockLedger[] @relation("UserStockLedgers")
  stockAdjustments StockAdjustment[] @relation("UserStockAdjustments")
  approvedAdjustments StockAdjustment[] @relation("ApprovedStockAdjustments")
  goodsReceipts    GoodsReceipt[]    @relation("UserGoodsReceipts")
  openingStockRecords OpeningStockRecord[] @relation("UserOpeningStock")
  createdProductionOrders ProductionOrder[] @relation("CreatedProductionOrders")
  approvedProductionOrders ProductionOrder[] @relation("ApprovedProductionOrders")
  supervisedProductionOrders ProductionOrder[] @relation("SupervisedProductionOrders")
  materialIssues   MaterialIssue[]   @relation("UserMaterialIssues")
  inspectedQuality QualityInspection[] @relation("UserQualityInspections")
  allocatedOrders  SalesOrder[]      @relation("AllocatedOrders")
  createdStockAllocations StockAllocation[] @relation("UserStockAllocations")
  createdSalesReturns SalesReturn[]    @relation("UserSalesReturns")
  approvedSalesReturns SalesReturn[]   @relation("ApprovedSalesReturns")
  reversedPayments Payment[] @relation("ReversedPayments")
  supplierPayments SupplierPayment[] @relation("UserSupplierPayments")
  reversedSupplierPayments SupplierPayment[] @relation("ReversedSupplierPayments")
  recordedExpenses Expense[] @relation("RecordedExpenses")
  approvedExpenses Expense[] @relation("ApprovedExpenses")
  financialAccountTransactions FinancialAccountTransaction[] @relation("UserFinancialAccountTransactions")
  journalEntries JournalEntry[] @relation("UserJournalEntries")
  bankStatements BankStatement[] @relation("UserBankStatements")
  reconciliations BankReconciliation[] @relation("UserReconciliations")
  auditLogs    AuditLog[]
  userActivityLogs UserActivityLog[]
  auditorSessions AuditSession[] @relation("AuditorSessions")
  assignedFindings AuditFinding[] @relation("AssignedFindings")
  inspectedFoodSafety FoodSafetyCompliance[] @relation("InspectorFoodSafety")
}

model Customer {
  id              String       @id @default(uuid())
  name            String
  type            CustomerType @default(RETAILER)
  gstin           String?
  contactPerson   String?
  billingAddress  String
  shippingAddress String
  city            String?
  district        String?
  state           String       @default("Tamil Nadu")
  stateCode       String       @default("33")
  pincode         String?
  contactNumber   String
  email           String?
  creditLimit     Decimal      @default(0.0) @db.Decimal(12, 2)
  paymentTerms    String?      @default("30 Days")
  active          Boolean      @default(true)
  salesmanId      String?
  salesman        User?        @relation("SalesmanCustomers", fields: [salesmanId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders          SalesOrder[]
  invoices        Invoice[]
  payments        Payment[]
  creditNotes     CreditNote[]
  salesReturns    SalesReturn[]

  @@index([salesmanId])
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  gstin         String?
  address       String
  city          String?
  state         String     @default("Tamil Nadu")
  stateCode     String     @default("33")
  pincode       String?
  contactPerson String?
  contactNumber String
  email         String?
  paymentTerms  String?    @default("30 Days")
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  purchases        Purchase[]
  supplierPayments SupplierPayment[]
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Product {
  id           String          @id @default(uuid())
  sku          String          @unique
  name         String
  description  String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  packSize     String          // e.g. "200 g"
  unit         String          @default("packets") // "packets", "cartons", "pieces"
  sellingPrice Decimal         @db.Decimal(12, 2)
  gstRate      Decimal         @default(5.0) @db.Decimal(5, 2)
  hsnCode      String          @default("1905")
  reorderLevel Decimal         @default(100) @db.Decimal(12, 2)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  boms         BOM[]
  orderItems   SalesOrderItem[]
  invoiceItems InvoiceItem[]
  dispatchItems DispatchItem[]
  productionRuns ProductionRun[]
  productionOrders ProductionOrder[]
  productionOutputs ProductionOutput[]
  qualityInspections QualityInspection[]
  stockAllocationItems StockAllocationItem[]
  salesReturnItems SalesReturnItem[]
  creditNoteItems CreditNoteItem[]

  @@index([sku])
}

model RawMaterial {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  category     String?
  description  String?
  uom          String    // "kg", "litre", "g", etc.
  openingStock Decimal   @default(0.0) @db.Decimal(12, 3)
  reorderLevel Decimal   @default(10.0) @db.Decimal(12, 3)
  purchasePrice Decimal  @default(0.0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bomItems     BOMItem[]
  purchaseItems PurchaseItem[]
  consumptions ProductionConsumption[]
  goodsReceiptItems GoodsReceiptItem[]
  bomItemSnapshots ProductionBOMItemSnapshot[]
  materialIssueItems MaterialIssueItem[]

  @@index([code])
}

model PackagingMaterial {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  packagingType String?
  uom           String    // "pieces", "cartons"
  openingStock  Decimal   @default(0.0) @db.Decimal(12, 2)
  reorderLevel  Decimal   @default(50.0) @db.Decimal(12, 2)
  purchasePrice Decimal   @default(0.0) @db.Decimal(12, 2)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bomItems      BOMItem[]
  purchaseItems PurchaseItem[]
  consumptions  ProductionConsumption[]
  goodsReceiptItems GoodsReceiptItem[]
  bomItemSnapshots ProductionBOMItemSnapshot[]
  materialIssueItems MaterialIssueItem[]

  @@index([code])
}

model BOM {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  name          String
  version       String    @default("v1.0")
  batchSize     Decimal   @db.Decimal(12, 2) // e.g. 200
  batchUnit     String    @default("packets")
  expectedYield Decimal   @db.Decimal(12, 2) // e.g. 200
  yieldUnit     String    @default("packets")
  effectiveDate DateTime  @default(now())
  active        Boolean   @default(true)
  status        String    @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         BOMItem[]
  productionRuns ProductionRun[]
  productionOrders ProductionOrder[]

  @@index([productId])
}

model BOMItem {
  id                  String             @id @default(uuid())
  bomId               String
  bom                 BOM                @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemType            ItemType           // RAW_MATERIAL or PACKAGING
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  standardQuantity    Decimal            @db.Decimal(12, 3)
  unit                String

  @@index([bomId])
}

model Unit {
  id          String   @id @default(uuid())
  code        String   @unique // "kg", "g", "litre", "ml", "pieces", "packets", "cartons"
  name        String
  category    String   // "WEIGHT", "VOLUME", "COUNT"
  baseUnit    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UnitConversion {
  id          String   @id @default(uuid())
  fromUnit    String
  toUnit      String
  factor      Decimal  @db.Decimal(12, 4)
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([fromUnit, toUnit])
}

model Purchase {
  id                    String         @id @default(uuid())
  purchaseNumber        String         @unique
  supplierId            String
  supplier              Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate          DateTime       @default(now())
  supplierInvoiceNumber String?
  totalTaxable          Decimal        @db.Decimal(12, 2)
  totalGst              Decimal        @db.Decimal(12, 2)
  grandTotal            Decimal        @db.Decimal(12, 2)
  status                String         @default("RECEIVED") // DRAFT, CONFIRMED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  paidAmount            Decimal        @default(0.0) @db.Decimal(12, 2)
  outstandingAmount     Decimal?       @db.Decimal(12, 2)
  paymentStatus         String         @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  receivedDate          DateTime?
  notes                 String?
  createdById           String
  createdBy             User           @relation("UserPurchases", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  items                 PurchaseItem[]
  goodsReceipts         GoodsReceipt[]
  supplierAllocations   SupplierPaymentAllocation[]

  @@index([purchaseNumber])
  @@index([supplierId])
}

model PurchaseItem {
  id                  String             @id @default(uuid())
  purchaseId          String
  purchase            Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemType            ItemType           // RAW_MATERIAL or PACKAGING
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  quantity            Decimal            @db.Decimal(12, 3)
  receivedQuantity    Decimal            @default(0.0) @db.Decimal(12, 3)
  unit                String
  unitPrice           Decimal            @db.Decimal(12, 2)
  gstRate             Decimal            @default(5.0) @db.Decimal(5, 2)
  taxableAmount       Decimal            @db.Decimal(12, 2)
  gstAmount           Decimal            @db.Decimal(12, 2)
  totalAmount         Decimal            @db.Decimal(12, 2)

  goodsReceiptItems   GoodsReceiptItem[]

  @@index([purchaseId])
}

model GoodsReceipt {
  id            String             @id @default(uuid())
  grnNumber     String             @unique
  purchaseId    String
  purchase      Purchase           @relation(fields: [purchaseId], references: [id])
  receiptDate   DateTime           @default(now())
  challanNumber String?
  vehicleNumber String?
  status        String             @default("POSTED") // DRAFT, POSTED, CANCELLED
  notes         String?
  receivedById  String
  receivedBy    User               @relation("UserGoodsReceipts", fields: [receivedById], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items         GoodsReceiptItem[]

  @@index([grnNumber])
  @@index([purchaseId])
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseItemId      String?
  purchaseItem        PurchaseItem?      @relation(fields: [purchaseItemId], references: [id])
  itemType            ItemType
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  orderedQuantity     Decimal            @db.Decimal(12, 3)
  receivedQuantity    Decimal            @db.Decimal(12, 3)
  acceptedQuantity    Decimal            @db.Decimal(12, 3)
  rejectedQuantity    Decimal            @default(0.0) @db.Decimal(12, 3)
  unit                String
  unitPrice           Decimal            @db.Decimal(12, 2)
  batchNumber         String?
  expiryDate          DateTime?
  rejectionReason     String?

  @@index([goodsReceiptId])
}


model ProductionRun {
  id                   String           @id @default(uuid())
  runNumber            String           @unique
  bomId                String
  bom                  BOM              @relation(fields: [bomId], references: [id])
  productId            String
  product              Product          @relation(fields: [productId], references: [id])
  runDate              DateTime         @default(now())
  plannedBatchQuantity Decimal          @db.Decimal(12, 2)
  expectedOutput       Decimal          @db.Decimal(12, 2)
  actualGoodOutput     Decimal          @db.Decimal(12, 2)
  damagedPouches       Decimal          @default(0.0) @db.Decimal(12, 2)
  cartonsUsed          Decimal          @default(0.0) @db.Decimal(12, 2)
  labourCost           Decimal          @default(0.0) @db.Decimal(12, 2)
  powerCost            Decimal          @default(0.0) @db.Decimal(12, 2)
  otherOverheads       Decimal          @default(0.0) @db.Decimal(12, 2)
  totalMaterialCost    Decimal          @default(0.0) @db.Decimal(12, 2)
  totalProductionCost  Decimal          @default(0.0) @db.Decimal(12, 2)
  costPerPacket        Decimal          @default(0.0) @db.Decimal(12, 2)
  yieldVariancePercent Decimal          @default(0.0) @db.Decimal(6, 2)
  yieldVarianceStatus  VarianceStatus   @default(NORMAL)
  status               String           @default("POSTED") // POSTED, CANCELLED
  notes                String?
  createdById          String
  createdBy            User             @relation("UserProductionRuns", fields: [createdById], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  productionOrderId    String?
  productionOrder      ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  consumptions         ProductionConsumption[]

  @@index([runNumber])
  @@index([productId])
  @@index([productionOrderId])
}

model ProductionOrder {
  id                   String           @id @default(uuid())
  orderNumber          String           @unique
  productId            String
  product              Product          @relation(fields: [productId], references: [id])
  bomId                String
  bom                  BOM              @relation(fields: [bomId], references: [id])
  bomVersion           String           @default("v1.0")
  plannedBatchQuantity Decimal          @db.Decimal(12, 2)
  plannedOutputQuantity Decimal         @db.Decimal(12, 2)
  actualOutputQuantity Decimal          @default(0.0) @db.Decimal(12, 2)
  startDate            DateTime         @default(now())
  expectedCompletionDate DateTime?
  actualCompletionDate DateTime?
  supervisorId         String?
  supervisor           User?            @relation("SupervisedProductionOrders", fields: [supervisorId], references: [id])
  priority             String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes                String?
  status               String           @default("DRAFT") // DRAFT, PLANNED, APPROVED, MATERIALS_RESERVED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  createdById          String
  createdBy            User             @relation("CreatedProductionOrders", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           User?            @relation("ApprovedProductionOrders", fields: [approvedById], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  bomSnapshot          ProductionBOMSnapshot?
  reservations         MaterialReservation[]
  materialIssues       MaterialIssue[]
  executions           ProductionExecution[]
  outputs              ProductionOutput[]
  qualityInspections   QualityInspection[]
  productionRuns       ProductionRun[]

  @@index([orderNumber])
  @@index([productId])
  @@index([status])
}

model ProductionBOMSnapshot {
  id                String                     @id @default(uuid())
  productionOrderId String                     @unique
  productionOrder   ProductionOrder            @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  bomId             String
  bomName           String
  version           String
  standardBatchSize Decimal                    @db.Decimal(12, 2)
  expectedYield     Decimal                    @db.Decimal(12, 2)
  yieldUnit         String
  snapshotDate      DateTime                   @default(now())

  items             ProductionBOMItemSnapshot[]
}

model ProductionBOMItemSnapshot {
  id                  String                 @id @default(uuid())
  snapshotId          String
  snapshot            ProductionBOMSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  itemType            ItemType
  rawMaterialId       String?
  rawMaterial         RawMaterial?           @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial?     @relation(fields: [packagingMaterialId], references: [id])
  materialName        String
  materialCode        String
  standardQuantity    Decimal                @db.Decimal(12, 3)
  scaledQuantity      Decimal                @db.Decimal(12, 3)
  unit                String

  @@index([snapshotId])
}

model MaterialReservation {
  id                String          @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemType          ItemType
  itemId            String
  reservedQuantity  Decimal         @db.Decimal(12, 3)
  unit              String
  status            String          @default("ACTIVE") // ACTIVE, CONSUMED, RELEASED, CANCELLED
  reservationDate   DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productionOrderId])
  @@index([itemId, itemType, status])
}

model MaterialIssue {
  id                String              @id @default(uuid())
  issueNumber       String              @unique
  productionOrderId String
  productionOrder   ProductionOrder     @relation(fields: [productionOrderId], references: [id])
  issueDate         DateTime            @default(now())
  issuedById        String
  issuedBy          User                @relation("UserMaterialIssues", fields: [issuedById], references: [id])
  status            String              @default("POSTED") // POSTED, CANCELLED
  notes             String?
  createdAt         DateTime            @default(now())

  items             MaterialIssueItem[]

  @@index([issueNumber])
  @@index([productionOrderId])
}

model MaterialIssueItem {
  id                     String             @id @default(uuid())
  materialIssueId        String
  materialIssue          MaterialIssue      @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  itemType               ItemType
  rawMaterialId          String?
  rawMaterial            RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId    String?
  packagingMaterial      PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  requestedQuantity      Decimal            @db.Decimal(12, 3)
  issuedQuantity         Decimal            @db.Decimal(12, 3)
  returnedQuantity       Decimal            @default(0.0) @db.Decimal(12, 3)
  actualConsumedQuantity Decimal            @default(0.0) @db.Decimal(12, 3)
  unit                   String
  unitCost               Decimal            @default(0.0) @db.Decimal(12, 2)
  totalCost              Decimal            @default(0.0) @db.Decimal(12, 2)
  stockLedgerId          String?

  @@index([materialIssueId])
}

model ProductionExecution {
  id                 String             @id @default(uuid())
  productionOrderId  String
  productionOrder    ProductionOrder    @relation(fields: [productionOrderId], references: [id])
  batchNumber        String             @unique
  productionDate     DateTime           @default(now())
  startTime          DateTime?
  endTime            DateTime?
  supervisorId       String?
  lineOrWorkstation  String?            @default("Line 1 - Frying & Packing")
  plannedOutput      Decimal            @db.Decimal(12, 2)
  actualOutput       Decimal            @default(0.0) @db.Decimal(12, 2)
  goodOutput         Decimal            @default(0.0) @db.Decimal(12, 2)
  rejectedOutput     Decimal            @default(0.0) @db.Decimal(12, 2)
  wastageQuantity    Decimal            @default(0.0) @db.Decimal(12, 2)
  status             String             @default("IN_PROGRESS") // IN_PROGRESS, PAUSED, COMPLETED, CANCELLED
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  outputs            ProductionOutput[]

  @@index([batchNumber])
  @@index([productionOrderId])
}

model ProductionOutput {
  id                    String               @id @default(uuid())
  outputNumber          String               @unique
  productionOrderId     String
  productionOrder       ProductionOrder      @relation(fields: [productionOrderId], references: [id])
  productionExecutionId String?
  productionExecution   ProductionExecution? @relation(fields: [productionExecutionId], references: [id])
  batchNumber           String
  productId             String
  product               Product              @relation(fields: [productId], references: [id])
  plannedOutput         Decimal              @db.Decimal(12, 2)
  actualOutput          Decimal              @db.Decimal(12, 2)
  goodPackets           Decimal              @db.Decimal(12, 2)
  rejectedPackets       Decimal              @default(0.0) @db.Decimal(12, 2)
  damagedPackets        Decimal              @default(0.0) @db.Decimal(12, 2)
  outputDate            DateTime             @default(now())
  manufacturingDate     DateTime             @default(now())
  expiryDate            DateTime?
  status                String               @default("POSTED") // POSTED
  unitCost              Decimal              @default(0.0) @db.Decimal(12, 2)
  totalValue            Decimal              @default(0.0) @db.Decimal(12, 2)
  recordedById          String
  approvedById          String?
  createdAt             DateTime             @default(now())

  @@index([outputNumber])
  @@index([batchNumber])
  @@index([productionOrderId])
}

model QualityInspection {
  id                  String          @id @default(uuid())
  inspectionNumber    String          @unique
  batchNumber         String
  productionOrderId   String
  productionOrder     ProductionOrder @relation(fields: [productionOrderId], references: [id])
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  inspectionDate      DateTime        @default(now())
  inspectedQuantity   Decimal         @db.Decimal(12, 2)
  acceptedQuantity    Decimal         @db.Decimal(12, 2)
  rejectedQuantity    Decimal         @default(0.0) @db.Decimal(12, 2)
  qualityStatus       String          @default("PASSED") // PENDING, PASSED, FAILED, CONDITIONAL
  weightConsistency   String?         @default("Within ±2g specification")
  packagingCondition  String?         @default("Hermetically sealed, no leakage")
  appearance          String?         @default("Uniform golden brown color, crisp texture")
  notes               String?
  inspectorId         String
  inspector           User            @relation("UserQualityInspections", fields: [inspectorId], references: [id])
  createdAt           DateTime        @default(now())

  @@index([inspectionNumber])
  @@index([batchNumber])
