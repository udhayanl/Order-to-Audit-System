datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SALESMAN
  ADMIN
  PRODUCTION_SUPERVISOR
  ACCOUNTANT_AUDITOR
  OWNER
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
  DISPATCHED
}

enum InvoiceStatus {
  POSTED
  CANCELLED
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  DISPATCH
  SALES_RETURN
  STOCK_ADJUSTMENT
  PURCHASE_RETURN
  WASTAGE
  DAMAGE
}

enum StockAdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
  PHYSICAL_COUNT
  DAMAGE
  WASTAGE
  EXPIRY
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
}

enum VarianceStatus {
  NORMAL
  EXCEEDS_TOLERANCE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customers    Customer[]    @relation("SalesmanCustomers")
  salesOrders  SalesOrder[]  @relation("SalesmanOrders")
  approvedOrders SalesOrder[] @relation("ApprovedOrders")
  purchases    Purchase[]    @relation("UserPurchases")
  productionRuns ProductionRun[] @relation("UserProductionRuns")
  invoices     Invoice[]     @relation("UserInvoices")
  payments     Payment[]     @relation("UserPayments")
  creditNotes  CreditNote[]  @relation("UserCreditNotes")
  dispatches   Dispatch[]    @relation("UserDispatches")
  stockLedgers StockLedger[] @relation("UserStockLedgers")
  stockAdjustments StockAdjustment[] @relation("UserStockAdjustments")
  approvedAdjustments StockAdjustment[] @relation("ApprovedStockAdjustments")
  goodsReceipts    GoodsReceipt[]    @relation("UserGoodsReceipts")
  openingStockRecords OpeningStockRecord[] @relation("UserOpeningStock")
  auditLogs    AuditLog[]
}

model Customer {
  id              String       @id @default(uuid())
  name            String
  type            CustomerType @default(RETAILER)
  gstin           String?
  contactPerson   String?
  billingAddress  String
  shippingAddress String
  city            String?
  district        String?
  state           String       @default("Tamil Nadu")
  stateCode       String       @default("33")
  pincode         String?
  contactNumber   String
  email           String?
  creditLimit     Decimal      @default(0.0) @db.Decimal(12, 2)
  paymentTerms    String?      @default("30 Days")
  active          Boolean      @default(true)
  salesmanId      String?
  salesman        User?        @relation("SalesmanCustomers", fields: [salesmanId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders          SalesOrder[]
  invoices        Invoice[]
  payments        Payment[]
  creditNotes     CreditNote[]

  @@index([salesmanId])
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  gstin         String?
  address       String
  city          String?
  state         String     @default("Tamil Nadu")
  stateCode     String     @default("33")
  pincode       String?
  contactPerson String?
  contactNumber String
  email         String?
  paymentTerms  String?    @default("30 Days")
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  purchases     Purchase[]
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Product {
  id           String          @id @default(uuid())
  sku          String          @unique
  name         String
  description  String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  packSize     String          // e.g. "200 g"
  unit         String          @default("packets") // "packets", "cartons", "pieces"
  sellingPrice Decimal         @db.Decimal(12, 2)
  gstRate      Decimal         @default(5.0) @db.Decimal(5, 2)
  hsnCode      String          @default("1905")
  reorderLevel Decimal         @default(100) @db.Decimal(12, 2)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  boms         BOM[]
  orderItems   SalesOrderItem[]
  invoiceItems InvoiceItem[]
  dispatchItems DispatchItem[]
  productionRuns ProductionRun[]

  @@index([sku])
}

model RawMaterial {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  category     String?
  description  String?
  uom          String    // "kg", "litre", "g", etc.
  openingStock Decimal   @default(0.0) @db.Decimal(12, 3)
  reorderLevel Decimal   @default(10.0) @db.Decimal(12, 3)
  purchasePrice Decimal  @default(0.0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bomItems     BOMItem[]
  purchaseItems PurchaseItem[]
  consumptions ProductionConsumption[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([code])
}

model PackagingMaterial {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  packagingType String?
  uom           String    // "pieces", "cartons"
  openingStock  Decimal   @default(0.0) @db.Decimal(12, 2)
  reorderLevel  Decimal   @default(50.0) @db.Decimal(12, 2)
  purchasePrice Decimal   @default(0.0) @db.Decimal(12, 2)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bomItems      BOMItem[]
  purchaseItems PurchaseItem[]
  consumptions  ProductionConsumption[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([code])
}

model BOM {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  name          String
  version       String    @default("v1.0")
  batchSize     Decimal   @db.Decimal(12, 2) // e.g. 200
  batchUnit     String    @default("packets")
  expectedYield Decimal   @db.Decimal(12, 2) // e.g. 200
  yieldUnit     String    @default("packets")
  effectiveDate DateTime  @default(now())
  active        Boolean   @default(true)
  status        String    @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         BOMItem[]
  productionRuns ProductionRun[]

  @@index([productId])
}

model BOMItem {
  id                  String             @id @default(uuid())
  bomId               String
  bom                 BOM                @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemType            ItemType           // RAW_MATERIAL or PACKAGING
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  standardQuantity    Decimal            @db.Decimal(12, 3)
  unit                String

  @@index([bomId])
}

model Unit {
  id          String   @id @default(uuid())
  code        String   @unique // "kg", "g", "litre", "ml", "pieces", "packets", "cartons"
  name        String
  category    String   // "WEIGHT", "VOLUME", "COUNT"
  baseUnit    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UnitConversion {
  id          String   @id @default(uuid())
  fromUnit    String
  toUnit      String
  factor      Decimal  @db.Decimal(12, 4)
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([fromUnit, toUnit])
}

model Purchase {
  id                    String         @id @default(uuid())
  purchaseNumber        String         @unique
  supplierId            String
  supplier              Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate          DateTime       @default(now())
  supplierInvoiceNumber String?
  totalTaxable          Decimal        @db.Decimal(12, 2)
  totalGst              Decimal        @db.Decimal(12, 2)
  grandTotal            Decimal        @db.Decimal(12, 2)
  status                String         @default("RECEIVED") // DRAFT, CONFIRMED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  receivedDate          DateTime?
  notes                 String?
  createdById           String
  createdBy             User           @relation("UserPurchases", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  items                 PurchaseItem[]
  goodsReceipts         GoodsReceipt[]

  @@index([purchaseNumber])
  @@index([supplierId])
}

model PurchaseItem {
  id                  String             @id @default(uuid())
  purchaseId          String
  purchase            Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemType            ItemType           // RAW_MATERIAL or PACKAGING
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  quantity            Decimal            @db.Decimal(12, 3)
  receivedQuantity    Decimal            @default(0.0) @db.Decimal(12, 3)
  unit                String
  unitPrice           Decimal            @db.Decimal(12, 2)
  gstRate             Decimal            @default(5.0) @db.Decimal(5, 2)
  taxableAmount       Decimal            @db.Decimal(12, 2)
  gstAmount           Decimal            @db.Decimal(12, 2)
  totalAmount         Decimal            @db.Decimal(12, 2)

  goodsReceiptItems   GoodsReceiptItem[]

  @@index([purchaseId])
}

model GoodsReceipt {
  id            String             @id @default(uuid())
  grnNumber     String             @unique
  purchaseId    String
  purchase      Purchase           @relation(fields: [purchaseId], references: [id])
  receiptDate   DateTime           @default(now())
  challanNumber String?
  vehicleNumber String?
  status        String             @default("POSTED") // DRAFT, POSTED, CANCELLED
  notes         String?
  receivedById  String
  receivedBy    User               @relation("UserGoodsReceipts", fields: [receivedById], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items         GoodsReceiptItem[]

  @@index([grnNumber])
  @@index([purchaseId])
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseItemId      String?
  purchaseItem        PurchaseItem?      @relation(fields: [purchaseItemId], references: [id])
  itemType            ItemType
  rawMaterialId       String?
  rawMaterial         RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  orderedQuantity     Decimal            @db.Decimal(12, 3)
  receivedQuantity    Decimal            @db.Decimal(12, 3)
  acceptedQuantity    Decimal            @db.Decimal(12, 3)
  rejectedQuantity    Decimal            @default(0.0) @db.Decimal(12, 3)
  unit                String
  unitPrice           Decimal            @db.Decimal(12, 2)
  batchNumber         String?
  expiryDate          DateTime?
  rejectionReason     String?

  @@index([goodsReceiptId])
}


model ProductionRun {
  id                   String           @id @default(uuid())
  runNumber            String           @unique
  bomId                String
  bom                  BOM              @relation(fields: [bomId], references: [id])
  productId            String
  product              Product          @relation(fields: [productId], references: [id])
  runDate              DateTime         @default(now())
  plannedBatchQuantity Decimal          @db.Decimal(12, 2)
  expectedOutput       Decimal          @db.Decimal(12, 2)
  actualGoodOutput     Decimal          @db.Decimal(12, 2)
  damagedPouches       Decimal          @default(0.0) @db.Decimal(12, 2)
  cartonsUsed          Decimal          @default(0.0) @db.Decimal(12, 2)
  labourCost           Decimal          @default(0.0) @db.Decimal(12, 2)
  powerCost            Decimal          @default(0.0) @db.Decimal(12, 2)
  otherOverheads       Decimal          @default(0.0) @db.Decimal(12, 2)
  totalMaterialCost    Decimal          @default(0.0) @db.Decimal(12, 2)
  totalProductionCost  Decimal          @default(0.0) @db.Decimal(12, 2)
  costPerPacket        Decimal          @default(0.0) @db.Decimal(12, 2)
  yieldVariancePercent Decimal          @default(0.0) @db.Decimal(6, 2)
  yieldVarianceStatus  VarianceStatus   @default(NORMAL)
  status               String           @default("POSTED") // POSTED, CANCELLED
  notes                String?
  createdById          String
  createdBy            User             @relation("UserProductionRuns", fields: [createdById], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  consumptions         ProductionConsumption[]

  @@index([runNumber])
  @@index([productId])
}

model ProductionConsumption {
  id                        String             @id @default(uuid())
  productionRunId           String
  productionRun             ProductionRun      @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  itemType                  ItemType
  rawMaterialId             String?
  rawMaterial               RawMaterial?       @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId       String?
  packagingMaterial         PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  plannedQuantity           Decimal            @db.Decimal(12, 3)
  actualQuantity            Decimal            @db.Decimal(12, 3)
  unit                      String
  consumptionVariancePercent Decimal           @default(0.0) @db.Decimal(6, 2)
  varianceStatus            VarianceStatus     @default(NORMAL)
  unitCost                  Decimal            @default(0.0) @db.Decimal(12, 2)
  totalCost                 Decimal            @default(0.0) @db.Decimal(12, 2)

  @@index([productionRunId])
}

model SalesOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  salesmanId      String
  salesman        User             @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  orderDate       DateTime         @default(now())
  status          OrderStatus      @default(SUBMITTED)
  subtotal        Decimal          @db.Decimal(12, 2)
  estimatedGst    Decimal          @db.Decimal(12, 2)
  grandTotal      Decimal          @db.Decimal(12, 2)
  orderNotes      String?
  rejectionReason String?
  approvedById    String?
  approvedBy      User?            @relation("ApprovedOrders", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           SalesOrderItem[]
  invoice         Invoice?
  dispatch        Dispatch?

  @@index([orderNumber])
  @@index([customerId])
  @@index([salesmanId])
}

model SalesOrderItem {
  id            String     @id @default(uuid())
  salesOrderId  String
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Decimal    @db.Decimal(12, 2)
  unitPrice     Decimal    @db.Decimal(12, 2)
  gstRate       Decimal    @default(5.0) @db.Decimal(5, 2)
  taxableAmount Decimal    @db.Decimal(12, 2)
  gstAmount     Decimal    @db.Decimal(12, 2)
  totalAmount   Decimal    @db.Decimal(12, 2)

  @@index([salesOrderId])
}

model Invoice {
  id                String         @id @default(uuid())
  invoiceNumber     String         @unique
  financialYear     String         // e.g. "2026-27"
  orderId           String?        @unique
  order             SalesOrder?    @relation(fields: [orderId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  invoiceDate       DateTime       @default(now())
  dueDate           DateTime
  billingAddress    String
  shippingAddress   String
  placeOfSupply     String         // "Tamil Nadu (33)" or "Karnataka (29)"
  totalTaxable      Decimal        @db.Decimal(12, 2)
  cgstAmount        Decimal        @default(0.0) @db.Decimal(12, 2)
  sgstAmount        Decimal        @default(0.0) @db.Decimal(12, 2)
  igstAmount        Decimal        @default(0.0) @db.Decimal(12, 2)
  grandTotal        Decimal        @db.Decimal(12, 2)
  paidAmount        Decimal        @default(0.0) @db.Decimal(12, 2)
  outstandingAmount Decimal        @db.Decimal(12, 2)
  status            InvoiceStatus  @default(POSTED)
  notes             String?
  createdById       String
  createdBy         User           @relation("UserInvoices", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items             InvoiceItem[]
  creditNotes       CreditNote[]
  allocations       PaymentAllocation[]
  dispatches        Dispatch[]

  @@index([invoiceNumber])
  @@index([customerId])
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  hsnCode       String   @default("1905")
  description   String
  quantity      Decimal  @db.Decimal(12, 2)
  unit          String   @default("packets")
  unitPrice     Decimal  @db.Decimal(12, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  gstRate       Decimal  @default(5.0) @db.Decimal(5, 2)
  cgstAmount    Decimal  @default(0.0) @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0.0) @db.Decimal(12, 2)
  igstAmount    Decimal  @default(0.0) @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
}

model CreditNote {
  id               String   @id @default(uuid())
  creditNoteNumber String   @unique
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  issueDate        DateTime @default(now())
  reason           String
  totalAmount      Decimal  @db.Decimal(12, 2)
  createdById      String
  createdBy        User     @relation("UserCreditNotes", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())

  @@index([creditNoteNumber])
}

model Dispatch {
  id             String         @id @default(uuid())
  dispatchNumber String         @unique
  orderId        String         @unique
  order          SalesOrder     @relation(fields: [orderId], references: [id])
  invoiceId      String?
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  dispatchDate   DateTime       @default(now())
  vehicleNumber  String?
  driverName     String?
  remarks        String?
  createdById    String
  createdBy      User           @relation("UserDispatches", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())

  items          DispatchItem[]

  @@index([dispatchNumber])
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 2)

  @@index([dispatchId])
}

model StockLedger {
  id              String            @id @default(uuid())
  itemType        ItemType
  itemId          String            // rawMaterialId, packagingMaterialId, or productId
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(12, 3) // positive for additions, negative for deductions
  balanceAfter    Decimal           @db.Decimal(12, 3)
  unit            String
  direction       String?           @default("IN") // "IN" or "OUT"
  transactionDate DateTime?         @default(now())
  unitRate        Decimal?          @db.Decimal(12, 2)
  totalValue      Decimal?          @db.Decimal(12, 2)
  batchNumber     String?
  expiryDate      DateTime?
  referenceType   String            // "PURCHASE", "PRODUCTION_RUN", "DISPATCH", "ADJUSTMENT", "OPENING", "GRN"
  referenceId     String?
  notes           String?
  userId          String?
  user            User?             @relation("UserStockLedgers", fields: [userId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([itemType, itemId])
  @@index([createdAt])
}

model InventoryBalance {
  id              String   @id @default(uuid())
  itemId          String
  itemType        ItemType
  currentQuantity Decimal  @default(0.0) @db.Decimal(12, 3)
  baseUnit        String
  lastUpdatedAt   DateTime @default(now()) @updatedAt

  @@unique([itemId, itemType])
  @@index([itemType])
}

model StockAdjustment {
  id               String                @id @default(uuid())
  adjustmentNumber String                @unique
  itemId           String
  itemType         ItemType              @default(RAW_MATERIAL)
  adjustmentType   StockAdjustmentType   @default(PHYSICAL_COUNT)
  systemQuantity   Decimal               @db.Decimal(12, 3)
  physicalQuantity Decimal               @db.Decimal(12, 3)
  difference       Decimal               @db.Decimal(12, 3) // physical - system
  unit             String                @default("kg")
  reason           String
  status           StockAdjustmentStatus @default(PENDING_APPROVAL)
  createdById      String
  createdBy        User                  @relation("UserStockAdjustments", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?                 @relation("ApprovedStockAdjustments", fields: [approvedById], references: [id])
  createdAt        DateTime              @default(now())
  approvedAt       DateTime?
  postedAt         DateTime?
  notes            String?

  @@index([itemId, itemType])
  @@index([adjustmentNumber])
}

model OpeningStockRecord {
  id           String   @id @default(uuid())
  recordNumber String   @unique
  date         DateTime @default(now())
  status       String   @default("POSTED") // POSTED
  notes        String?
  createdById  String
  createdBy    User     @relation("UserOpeningStock", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([recordNumber])
}


model InventoryValuationLayer {
  id                String   @id @default(uuid())
  itemType          ItemType
  itemId            String
  receivedDate      DateTime @default(now())
  originalQuantity  Decimal  @db.Decimal(12, 3)
  remainingQuantity Decimal  @db.Decimal(12, 3)
  unitCost          Decimal  @db.Decimal(12, 2)
  referenceType     String
  referenceId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([itemType, itemId, remainingQuantity])
}

model Payment {
  id              String              @id @default(uuid())
  paymentNumber   String              @unique
  customerId      String
  customer        Customer            @relation(fields: [customerId], references: [id])
  paymentDate     DateTime            @default(now())
  amount          Decimal             @db.Decimal(12, 2)
  paymentMethod   PaymentMethod       @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  createdById     String
  createdBy       User                @relation("UserPayments", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())

  allocations     PaymentAllocation[]

  @@index([paymentNumber])
  @@index([customerId])
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String   // "CREATE", "UPDATE", "APPROVE", "REJECT", "DISPATCH", "POST", "CANCEL"
  entityType     String   // "ORDER", "INVOICE", "PRODUCTION_RUN", "PURCHASE", "PAYMENT", "STOCK"
  entityId       String
  previousValues String?  // JSON string
  newValues      String?  // JSON string
  ipAddress      String?
  timestamp      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}
