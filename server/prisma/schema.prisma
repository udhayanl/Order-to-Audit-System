  quantity          Decimal   @db.Decimal(12, 2)
  batchNumber       String?
  manufacturingDate DateTime?
  expiryDate        DateTime?

  @@index([dispatchId])
}

model StockLedger {
  id              String            @id @default(uuid())
  itemType        ItemType
  itemId          String            // rawMaterialId, packagingMaterialId, or productId
  movementType    StockMovementType
