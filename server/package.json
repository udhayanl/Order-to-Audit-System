{
  "name": "factoryflow-server",
  "version": "1.0.0",
  "description": "FactoryFlow Backend - Order-to-Audit Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "import:dataset": "tsx src/scripts/import-extended-dataset.ts",
    "benchmark": "tsx src/scripts/run-benchmark.ts",
    "benchmark:phase3": "tsx src/scripts/verify-phase3-benchmark.ts",
    "benchmark:phase4": "tsx src/scripts/verify-phase4-benchmark.ts",
    "benchmark:phase5": "tsx src/scripts/verify-phase5-benchmark.ts",
    "benchmark:phase6": "tsx src/scripts/verify-phase6-benchmark.ts",
    "audit:bom": "tsx src/scripts/audit-bom-production.ts",
    "evaluate": "tsx src/scripts/evaluator.ts",
    "test:masters": "tsx src/tests/master-crud.test.ts",
    "test:inventory": "tsx src/tests/inventory-stock-ledger.test.ts",
    "test:production": "tsx src/tests/production-manufacturing.test.ts",
    "test:sales": "tsx src/tests/sales-dispatch.test.ts",
    "test:finance": "tsx src/tests/financial-management.test.ts",
    "test:audit": "tsx src/tests/audit-compliance.test.ts",
    "test:phase8": "tsx src/tests/phase8-master-integration.test.ts",
    "test": "tsx src/tests/run-all-tests.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "prisma": "^5.17.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}