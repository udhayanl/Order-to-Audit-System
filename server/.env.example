# ==============================================================================
# FACTORYFLOW BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to version control.

# Server Network Port
PORT=5000

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# PostgreSQL Database Connection String
# Replace <user>, <password>, <host>, <port>, <dbname> with your actual values
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/factoryflow?schema=public"

# Cryptographically Secure JWT Secret Key (min 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_MIN_32_CHARS"

# Allowed Frontend Origin for CORS (e.g. https://factoryflow.yourdomain.com or '*')
CLIENT_ORIGIN="http://localhost:3000"
